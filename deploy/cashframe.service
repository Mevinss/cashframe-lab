[Unit]
Description=CashFrame local inference API
After=network.target

[Service]
Type=simple
User=cashframe
Group=cashframe
WorkingDirectory=/opt/cashframe
Environment=PYTHONPATH=/opt/cashframe/src
Environment=PYTHONIOENCODING=utf-8
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
EnvironmentFile=/etc/cashframe.env
ExecStart=/opt/cashframe/.venv/bin/python -m cashframe.launcher --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
MemoryMax=2560M
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cashframe/local
UMask=0077
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
