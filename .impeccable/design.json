  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "description": "Main action with burgundy hover and a visible keyboard outline.",
      "html": "<button class=\"ds-primary\">Начать проверку</button>",
      "css": ".ds-primary{font-family:'Segoe UI',Arial,sans-serif;font-size:13px;display:inline-flex;align-items:center;justify-content:center;gap:14px;padding:11px 20px;min-height:46px;border-radius:6px;font-weight:650;cursor:pointer;transition:background-color .15s ease,border-color .15s ease;color:white;background:var(--accent,#7b143e);border:1px solid var(--accent,#7b143e)}.ds-primary:hover:not(:disabled){background:var(--accent-hover,#601031)}.ds-primary:focus-visible{outline:2px solid var(--accent,#7b143e);outline-offset:4px;}.ds-primary:disabled{opacity:.45;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}",
      "refersTo": "button-primary"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "description": "A supporting action with a quiet outlined surface.",
      "html": "<button class=\"ds-secondary\">Проверить другое видео</button>",
      "css": ".ds-secondary{font-family:'Segoe UI',Arial,sans-serif;font-size:13px;display:inline-flex;align-items:center;justify-content:center;gap:14px;padding:11px 20px;min-height:46px;border-radius:6px;font-weight:650;cursor:pointer;transition:background-color .15s ease,border-color .15s ease;color:var(--ink,#252529);background:var(--surface,#fff);border:1px solid #cfcbd0}.ds-secondary:hover{background:#f4f1f3}.ds-secondary:focus-visible{outline:2px solid var(--accent,#7b143e);outline-offset:4px;}.ds-secondary:disabled{opacity:.45;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}",
      "refersTo": "button-secondary"
    },
    {
      "name": "Labeled field",
      "kind": "input",
      "description": "Explicit label and native input; the access key remains session-only.",
      "html": "<label class=\"ds-label\" for=\"ds-key\">Ключ доступа<input class=\"ds-field\" id=\"ds-key\" type=\"password\" placeholder=\"Введите ключ доступа\" autocomplete=\"off\"></label>",
      "css": ".ds-label{font-family:'Segoe UI',Arial,sans-serif;font-size:13px;display:block;color:var(--ink,#252529);font-weight:600}.ds-field{font-family:'Segoe UI',Arial,sans-serif;font-size:13px;display:block;width:100%;min-height:44px;margin-top:7px;padding:11px 12px;border:1px solid #cfcbd0;border-radius:6px;background:var(--surface,#fff);color:var(--ink,#252529);caret-color:var(--accent,#7b143e)}.ds-field::placeholder{color:#757179;font-weight:400;opacity:1}.ds-field:focus-visible{outline:2px solid var(--accent,#7b143e);outline-offset:4px;}",
      "refersTo": "field"
    },
    {
      "name": "Workflow",
      "kind": "nav",
      "description": "Ordered current-step indicator; informational steps have no invented navigation behavior.",
      "html": "<nav class=\"ds-workflow\" aria-label=\"Ход проверки\"><ol><li aria-current=\"step\">Загрузка</li><li>Обработка</li><li>Результат</li></ol></nav>",
      "css": ".ds-workflow{font-family:'Segoe UI',Arial,sans-serif;font-size:13px;}.ds-workflow ol{display:flex;gap:36px;list-style:none;padding:0;margin:0}.ds-workflow li{color:var(--muted,#65636a);padding-bottom:9px}.ds-workflow li[aria-current]{color:var(--accent,#7b143e);font-weight:650;border-bottom:2px solid var(--accent,#7b143e)}@media(max-width:720px){.ds-workflow ol{gap:30px}}"
    },
    {
      "name": "Priority badges",
      "kind": "chip",
      "description": "Text stays present for every priority; unspecified is the default unresolved state.",
      "html": "<div class=\"ds-badges\"><span class=\"ds-badge\">Приоритет не определён</span><span class=\"ds-badge ds-high\">Высокий</span><span class=\"ds-badge ds-medium\">Средний</span><span class=\"ds-badge ds-low\">Низкий</span></div>",
      "css": ".ds-badges{display:flex;gap:8px;flex-wrap:wrap}.ds-badge{font-family:'Segoe UI',Arial,sans-serif;font-size:10px;font-weight:600;display:inline-block;padding:4px 8px;border-radius:4px;background:#f0edf1;color:#62566a}.ds-high{background:#fff0f2;color:var(--high,#a22238)}.ds-medium{background:#fff5df;color:var(--medium,#855400)}.ds-low{background:#edf5fb;color:var(--low,#245c82)}",
      "refersTo": "badge-unspecified"
    },
    {
      "name": "Working panel",
      "kind": "card",
      "description": "Flat bordered container; headings and helper text remain compact.",
      "html": "<section class=\"ds-panel\"><h2>Что означает сигнал</h2><p>Сигнал модели требует проверки человеком.</p></section>",
      "css": ".ds-panel{font-family:'Segoe UI',Arial,sans-serif;color:var(--ink,#252529);background:var(--surface,#fff);border:1px solid var(--line,#e3e1e4);border-radius:12px;padding:28px}.ds-panel h2{font-size:18px;font-weight:650;line-height:1.35;margin:0 0 12px}.ds-panel p{font-size:13px;line-height:1.55;color:var(--muted,#65636a);margin:0}",
      "refersTo": "panel"
